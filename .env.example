# ═══════════════════════════════════════════════════════════
# FinanceGPT Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════

# ─── App ─────────────────────────────────────────────────
ENVIRONMENT=production       # development | production
DEBUG=false
DOMAIN=financegpt.yourdomain.com

# ─── Security ────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE-ME-GENERATE-A-STRONG-RANDOM-KEY

# ─── Database ────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ─── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ─── Anthropic / Claude ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-opus-4-6   # or claude-sonnet-4-6 for lower cost

# ─── QuickBooks OAuth (optional) ─────────────────────────
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox          # sandbox | production

# ─── Xero OAuth (optional) ───────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# ─── Frontend ────────────────────────────────────────────
VITE_API_URL=/api               # For production: https://api.yourdomain.com/api
